# The web planner's routing service on the relay VPS (tools/deploy-webplanner.sh puts it in /etc/systemd/system).
# Shares two cores with the relay: lower priority, and capped so a burst of routes can't starve the relay.
[Unit]
Description=Curveon web planner (routing)
After=network.target

[Service]
User=planner
Group=planner
WorkingDirectory=/opt/curveon-planner
Environment=SEGMENTS=/opt/curveon-planner/segments
Environment=PORT=8788
Environment=TRUST_PROXY=1
Environment=POIS=/opt/curveon-planner/pois
# The gravel heat map, counted once per segment file and kept here (writable: StateDirectory).
Environment=HEAT=/var/lib/curveon-planner/heat
StateDirectory=curveon-planner
# Two searches at once (~660 MB) and Europe's places in memory (some tens of MB).
ExecStart=/usr/bin/java -Xmx800m -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError -jar /opt/curveon-planner/webplanner-server.jar
Restart=always
RestartSec=3
Nice=10
CPUWeight=50
MemoryMax=1200M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/opt/curveon-planner

[Install]
WantedBy=multi-user.target
