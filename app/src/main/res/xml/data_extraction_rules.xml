<?xml version="1.0" encoding="utf-8"?><!--
   The group rides' keys are tied to this device's keystore, so a restored copy is useless: leave
   them out. (Everything else is backed up as before.)
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="groups.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="groups.xml"/>
    </device-transfer>
</data-extraction-rules>
