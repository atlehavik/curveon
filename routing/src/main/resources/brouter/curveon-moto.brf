# Curveon motorcycle profile for BRouter (standard cost model).
#
# costfactor is "cost per metre". For FASTEST it approximates travel time
# (1.0 = motorway at ~110 km/h); CURVY / VERY_CURVY make big roads expensive so
# the router prefers secondary, tertiary and unclassified roads, which in Norway
# are where the curves are. Real curvature is scored afterwards from geometry.

---context:global

assign validForCars = true

assign road_style      = 0      # %road_style% | 0 = fastest, 1 = curvy, 2 = very curvy | number
assign surface_pref    = 0      # %surface_pref% | 0 = paved only, 1 = mixed, 2 = gravel | number
assign avoid_ferries   = false  # %avoid_ferries% | Avoid ferries | boolean
assign avoid_motorways = false  # %avoid_motorways% | Avoid motorways | boolean
assign avoid_toll      = false  # %avoid_toll% | Avoid toll roads | boolean
assign tracks_last_resort = 1    # %tracks_last_resort% | With Tarmac, tracks may still be used to reach a place on one (0 = never) | number
assign look_past_paths = 0       # %look_past_paths% | Only for finding where an own road meets a path: paths count (never ridden) | number
assign avoided_ferry_cost = 1000000 # %avoided_ferry_cost% | Cost of one ferry when avoiding them (~1 per metre of detour) | number

assign downhillcost = 0
assign uphillcost   = 0

# Used only by BRouter's own (bike-oriented) time estimate; we compute ETA ourselves.
assign totalMass  = 350
assign maxSpeed   = 110
assign bikerPower = 15000

assign turnInstructionMode          = 3     # osmand-style hints, mapped to our own maneuvers
assign turnInstructionCatchingRange = 40
assign turnInstructionRoundabouts   = true
assign considerTurnRestrictions     = true
assign processUnusedTags            = true   # export maxspeed etc. for the speed-limit sign

# Search: pass 1 is a quick greedy A* that finds some route; pass 2 then finds the best one but
# skips anything that cannot beat it. pass2coefficient is the A* estimate of remaining cost per
# metre of straight-line distance; it must not exceed the cheapest costfactor (1.0 for tarmac,
# 0.85 for gravel when gravel is preferred) or the result is no longer the best route.
assign pass1coefficient = 1.5

assign fastest    = equal road_style 0
assign curvy      = equal road_style 1
assign very_curvy = equal road_style 2

assign paved_only   = equal surface_pref 0
assign mixed        = equal surface_pref 1
assign gravel_lover = equal surface_pref 2
assign no_tracks    = and paved_only ( equal tracks_last_resort 0 )

assign pass2coefficient = if gravel_lover then 0.85 else 1.0

---context:way

assign classifier_none  = 1
assign classifier_ferry = 2

assign isresidentialorliving = or highway=residential|living_street living_street=yes

assign is_track = highway=track|road

assign motoraccess
       switch motorcycle=
              switch motor_vehicle=
                     switch vehicle=
                            switch access=
                                   switch highway=motorway|motorway_link       1
                                   switch highway=trunk|trunk_link             1
                                   switch highway=primary|primary_link         1
                                   switch highway=secondary|secondary_link     1
                                   switch highway=tertiary|tertiary_link       1
                                   switch highway=unclassified                 1
                                   switch route=ferry                          1
                                   switch isresidentialorliving                1
                                   switch highway=service                      1
                                   switch is_track                             ( not no_tracks )
                                   0
                                   access=yes|permissive|designated|destination
                            vehicle=yes|permissive|designated|destination
                     motor_vehicle=yes|permissive|designated|destination
              motorcycle=yes|permissive|designated|destination

assign motoraccess_destination
       switch motorcycle=
              switch motor_vehicle=
                     switch vehicle=
                            access=destination
                            vehicle=destination
                     motor_vehicle=destination
              motorcycle=destination

assign isbadoneway = if reversedirection=yes then ( if oneway= then junction=roundabout else oneway=yes|true|1 ) else oneway=-1
assign isgoodoneway = if reversedirection=yes then oneway=-1
                      else if oneway= then junction=roundabout else oneway=yes|true|1
assign isroundabout = junction=roundabout
assign islinktype = highway=motorway_link|trunk_link|primary_link|secondary_link|tertiary_link

assign is_unpaved =
       if surface= then is_track
       else surface=unpaved|gravel|ground|dirt|compacted|fine_gravel|pebblestone|earth|sand|grass|mud|clay|rock

assign turncost = if fastest then 30 else 10

assign initialclassifier = if route=ferry then classifier_ferry else classifier_none

# An avoided ferry costs as much as a ~1000 km detour by default: taken only when there is no
# road at all (an island destination), never to save time. Roundtrip planning lowers it, see
# RoundtripPlanner.
assign initialcost =
       if route=ferry then ( if avoid_ferries then avoided_ferry_cost else 3000 )
       else 0

# Base cost per metre by road class and riding style
assign class_cost =
  if fastest then
  (
    switch highway=motorway                  1.0
    switch highway=motorway_link             1.3
    switch highway=trunk                     1.15
    switch highway=trunk_link                1.4
    switch highway=primary|primary_link      1.35
    switch highway=secondary|secondary_link  1.5
    switch highway=tertiary|tertiary_link    1.7
    switch highway=unclassified              2.0
    switch isresidentialorliving             3.0
    switch highway=service                   4.0
    switch is_track                          5.0
    switch route=ferry                       3.0
    10000
  )
  else if curvy then
  (
    switch highway=motorway                  3.0
    switch highway=motorway_link             3.0
    switch highway=trunk                     2.0
    switch highway=trunk_link                2.2
    switch highway=primary|primary_link      1.5
    switch highway=secondary|secondary_link  1.1
    switch highway=tertiary|tertiary_link    1.0
    switch highway=unclassified              1.15
    switch isresidentialorliving             3.0
    switch highway=service                   4.0
    switch is_track                          2.5
    switch route=ferry                       3.0
    10000
  )
  else
  (
    switch highway=motorway                  6.0
    switch highway=motorway_link             6.0
    switch highway=trunk                     3.5
    switch highway=trunk_link                3.5
    switch highway=primary|primary_link      2.0
    switch highway=secondary|secondary_link  1.15
    switch highway=tertiary|tertiary_link    1.0
    switch highway=unclassified              1.05
    switch isresidentialorliving             3.0
    switch highway=service                   4.0
    switch is_track                          2.0
    switch route=ferry                       3.0
    10000
  )

assign surface_factor =
  if is_unpaved then
  (
    if paved_only then 8.0
    else if mixed then 1.4
    else 0.85
  )
  else
  (
    if gravel_lover then 1.15 else 1.0
  )

# Any track is a road an adventure bike can ride. With Tarmac it is a last resort (to reach a
# place that is only on a track), never a short cut; rougher grades cost more, none is forbidden.
assign track_factor =
  if not is_track then 1.0
  else if no_tracks then 10000
  else if paved_only then 6.0
  else switch tracktype=grade1|grade2 1.0
       switch tracktype=grade3 ( if gravel_lover then 1.3 else 3.0 )
       switch tracktype=grade4 ( if gravel_lover then 2.0 else 5.0 )
       switch tracktype=grade5 ( if gravel_lover then 3.0 else 8.0 )
       ( if gravel_lover then 1.5 else 4.0 )

assign avoid_factor =
  multiply ( if and avoid_motorways highway=motorway|motorway_link then 8.0 else 1.0 )
           ( if and avoid_toll toll=yes then 5.0 else 1.0 )

assign road_cost = multiply class_cost multiply surface_factor multiply track_factor avoid_factor

# Roads a motorcycle physically can use but may not be allowed on (private farm/cabin roads):
# very expensive instead of forbidden, so a ride can start or end on one. Cycle paths and
# footpaths are never ridden: that is against the law.
assign is_motor_road = highway=motorway|motorway_link|trunk|trunk_link|primary|primary_link|secondary|secondary_link|tertiary|tertiary_link|unclassified|residential|living_street|service|track|road

assign costfactor =
  if not motoraccess then
  (
    if and is_motor_road not and is_track no_tracks then min 9999 max 8 multiply 2 road_cost
    else if and ( equal look_past_paths 1 ) highway=cycleway|footway|path|pedestrian|bridleway|steps then 30
    else 10000
  )
  else if isbadoneway then 10000
  else min 9999 road_cost

# way priorities used for turn instruction generation
assign priorityclassifier =
  if      ( highway=motorway                  ) then  30
  else if ( highway=motorway_link             ) then  29
  else if ( highway=trunk                     ) then  28
  else if ( highway=trunk_link                ) then  27
  else if ( highway=primary                   ) then  26
  else if ( highway=primary_link              ) then  25
  else if ( highway=secondary                 ) then  24
  else if ( highway=secondary_link            ) then  23
  else if ( highway=tertiary                  ) then  22
  else if ( highway=tertiary_link             ) then  21
  else if ( highway=unclassified              ) then  20
  else if ( isresidentialorliving             ) then  6
  else if ( highway=service                   ) then  6
  else if ( highway=track                     ) then if tracktype=grade1 then 4 else 2
  else if ( highway=bridleway|road            ) then  2
  else 0

assign isgoodforcars = if greater priorityclassifier 6 then true
                  else if or isresidentialorliving highway=service then true
                  else if ( and highway=track tracktype=grade1 ) then true
                  else false

assign classifiermask add          isbadoneway
                      add multiply isgoodoneway   2
                      add multiply isroundabout   4
                      add multiply islinktype     8
                      add multiply isgoodforcars 16
                      add multiply isresidentialorliving 32
                          multiply motoraccess_destination 64

---context:node

assign motoraccess
       switch motorcycle=
              switch motor_vehicle=
                     switch vehicle=
                            switch access=
                                   not barrier=bollard|cycle_barrier|block
                                   access=yes|permissive|designated|destination
                            vehicle=yes|permissive|designated|destination
                     motor_vehicle=yes|permissive|designated|destination
              motorcycle=yes|permissive|designated|destination

# Gates ("bom") on Norwegian forest roads are usually passable; just avoid them when there is a choice.
assign initialcost =
       switch and avoid_toll barrier=toll_booth 1000000
       switch motoraccess ( switch barrier=gate|lift_gate 300 0 ) 1000000
